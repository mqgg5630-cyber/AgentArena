{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mqgg5630-cyber/AgentArena/docs/schemas/local-runner-result.schema.json",
  "title": "AgentArena local-runner result / status.json (v1.0)",
  "description": "Machine-readable verdict written by the local executor to local-runs/results/<jobId>/status.json. Spec: docs/local-runner-protocol.md.",
  "type": "object",
  "required": ["schemaVersion", "jobId", "state", "attempt", "kind", "requestedBy", "host", "timing"],
  "additionalProperties": true,
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "jobId": { "type": "string", "pattern": "^[0-9]{8}-[0-9]{3}-[a-z0-9][a-z0-9-]{2,39}$" },
    "state": { "enum": ["queued", "leased", "running", "succeeded", "failed", "cancelled", "timed_out", "skipped"] },
    "attempt": { "type": "integer", "minimum": 1 },
    "idempotencyKey": { "type": "string" },
    "kind": { "enum": ["benchmark", "probe", "command"] },
    "requestedBy": {
      "type": "object",
      "required": ["branch", "session"],
      "properties": {
        "branch": { "type": "string" },
        "session": { "type": "string" }
      }
    },
    "host": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": true,
      "properties": {
        "name": { "type": "string" },
        "os": { "type": "string" },
        "powershell": { "type": "string" }
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "queuedAt": { "type": "string" },
        "startedAt": { "type": "string" },
        "finishedAt": { "type": "string" },
        "durationMs": { "type": "integer", "minimum": 0 },
        "timeoutSeconds": { "type": "integer", "minimum": 1 }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "command": { "type": "string" },
        "cwd": { "type": "string" },
        "exitCode": { "type": ["integer", "null"] },
        "runId": { "type": "string", "description": "Equals summary.json.runId for benchmarks." },
        "stdoutLastLine": { "type": "string" }
      }
    },
    "requirements": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "declared": { "type": "object" },
        "actual": { "type": "object" },
        "satisfied": { "type": "boolean" },
        "unmet": { "type": "array", "items": { "type": "string" } }
      }
    },
    "envActual": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "gpu": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "vramGb": { "type": "number" },
              "driver": { "type": "string" },
              "cudaDriver": { "type": "string" }
            }
          }
        },
        "conda": { "type": "object" },
        "hardwareReport": { "type": "string" },
        "hardwareGenerated": { "type": "string" },
        "git": {
          "type": "object",
          "properties": {
            "branch": { "type": "string" },
            "commit": { "type": "string" }
          }
        }
      }
    },
    "artifacts": { "type": "array", "items": { "$ref": "#/$defs/artifact" } },
    "verdict": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "outcome": { "enum": ["pass", "fail", "inconclusive", "error"] },
        "failureCategory": { "enum": ["task-pack", "environment", "agent", "model", "validation", "cancelled", "unknown", null] },
        "totals": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "agentCount": { "type": "integer", "minimum": 0 },
            "successCount": { "type": "integer", "minimum": 0 },
            "tokens": { "type": "number", "minimum": 0 },
            "costUsd": { "type": "number", "minimum": 0 }
          }
        },
        "scores": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["variantId", "status"],
            "properties": {
              "variantId": { "type": "string" },
              "status": { "enum": ["success", "failed", "cancelled"] },
              "compositeScore": { "type": ["number", "null"] },
              "judges": {
                "type": "object",
                "properties": {
                  "passed": { "type": "integer", "minimum": 0 },
                  "total": { "type": "integer", "minimum": 0 }
                }
              },
              "durationMs": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "failedJudges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["variantId", "judgeId"],
            "properties": {
              "variantId": { "type": "string" },
              "judgeId": { "type": "string" },
              "label": { "type": "string" },
              "critical": { "type": "boolean" },
              "exitCode": { "type": ["integer", "null"] },
              "note": { "type": "string" }
            }
          }
        },
        "notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "error": {
      "type": ["object", "null"],
      "required": ["code", "message"],
      "properties": {
        "code": {
          "enum": [
            "requirements-unmet",
            "policy-rejected",
            "unsupported-schema",
            "unsupported-kind",
            "dependency-unmet",
            "duplicate-job-id",
            "lease-expired",
            "timeout",
            "engine-error",
            "cancelled",
            "internal-error"
          ]
        },
        "message": { "type": "string" }
      }
    },
    "logTail": { "type": "array", "items": { "type": "string" } },
    "links": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "attempts": {
      "type": "array",
      "description": "Optional per-attempt history, newest last.",
      "items": {
        "type": "object",
        "properties": {
          "attempt": { "type": "integer", "minimum": 1 },
          "state": { "enum": ["succeeded", "failed", "cancelled", "timed_out", "skipped"] },
          "startedAt": { "type": "string" },
          "finishedAt": { "type": "string" },
          "exitCode": { "type": ["integer", "null"] },
          "error": { "type": ["object", "null"] }
        }
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "required": ["path", "bytes", "committed"],
      "additionalProperties": true,
      "properties": {
        "path": { "type": "string", "description": "Path relative to local-runs/results/<jobId>/." },
        "role": { "enum": ["summary", "report", "decision", "csv", "trend", "log", "trace", "bundle", "other"] },
        "bytes": { "type": "integer", "minimum": 0 },
        "sha256": { "type": "string" },
        "committed": { "type": "boolean", "description": "false = recorded in the manifest only; see localPath/reason." },
        "localPath": { "type": "string" },
        "reason": { "type": "string" }
      }
    }
  }
}
